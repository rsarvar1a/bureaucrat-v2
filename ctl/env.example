# The production .env, barebones: copy this to the checkout root as .env.
#
# Compose reads it at `bureaucratctl up` time and passes the bot exactly what
# docker-compose.prod.yml names; the file itself never enters the image. A
# change here takes effect on the next `bureaucratctl up` or `deploy`.

# From the developer portal: Bot -> Token, and General Information -> Application ID.
DISCORD_TOKEN=""
DISCORD_CLIENT_ID=""

# The Postgres the stack runs for itself. The host and port are the compose
# network's and need no setting; the credentials are yours to choose once.
POSTGRES_USER="postgres"
POSTGRES_PASSWORD=""
POSTGRES_DB="bureaucrat"

# Optional. A guild id narrows command registration to that one server
# (instant, for testing); unset publishes globally, which is what production
# wants once the bot serves more than one. Changing this later leaves the old
# scope's registration behind: see engine/discord/commands/loader/sync.ts.
# DISCORD_GUILD_ID=""

# Optional, with defaults in code.
# LOG_LEVEL=""
# TEMPORARY_VIEW_TIMEOUT_MS=""
# How many offsite copies run at once (default 4). Each has its own webhook
# limit; the global ceiling is far off. Takes effect on the next restart.
# OFFSITE_CONCURRENCY=""
